#include <LedControl.h>

#define DIN_PIN 10
#define CLK_PIN 14
#define CS_PIN  16

#define BTN_LEFT  2
#define BTN_RIGHT 3

#define MAX_LENGTH 4

LedControl lc = LedControl(DIN_PIN, CLK_PIN, CS_PIN, 1);

// Kierunki
enum Direction { UP, RIGHT, DOWN, LEFT };
Direction dir = RIGHT;

// Punkt
struct Point {
  int x;
  int y;
};

// Snake
Point snake[64];
int snakeLength = 3;

Point food;

unsigned long lastMove = 0;
int gameSpeed = 300;

void setup() {
  pinMode(BTN_LEFT, INPUT_PULLUP);
  pinMode(BTN_RIGHT, INPUT_PULLUP);

  lc.shutdown(0, false);
  lc.setIntensity(0, 8);
  lc.clearDisplay(0);

  snake[0] = {3, 4};
  snake[1] = {2, 4};
  snake[2] = {1, 4};

  randomSeed(analogRead(A0));
  spawnFood();
}

void loop() {
  handleButtons();

  if (millis() - lastMove > gameSpeed) {
    lastMove = millis();
    moveSnake();
    draw();
  }
}

// =====================

void handleButtons() {
  if (!digitalRead(BTN_LEFT)) {
    dir = (Direction)((dir + 3) % 4);
    delay(150);
  }

  if (!digitalRead(BTN_RIGHT)) {
    dir = (Direction)((dir + 1) % 4);
    delay(150);
  }
}

// =====================

void moveSnake() {
  // przesuwanie ciała
  for (int i = snakeLength - 1; i > 0; i--) {
    snake[i] = snake[i - 1];
  }

  // ruch głowy
  if (dir == UP)    snake[0].y--;
  if (dir == DOWN)  snake[0].y++;
  if (dir == LEFT)  snake[0].x--;
  if (dir == RIGHT) snake[0].x++;

  // zawijanie
  snake[0].x = (snake[0].x + 8) % 8;
  snake[0].y = (snake[0].y + 8) % 8;

  // jabłko
  if (snake[0].x == food.x && snake[0].y == food.y) {
    if (snakeLength < MAX_LENGTH) {
      snakeLength++;
    }
    spawnFood();

    if (gameSpeed > 120) gameSpeed -= 10;
  }
}

// =====================

void draw() {
  lc.clearDisplay(0);

  // jabłko
  lc.setLed(0, food.y, food.x, true);

  // snake
  for (int i = 0; i < snakeLength; i++) {
    lc.setLed(0, snake[i].y, snake[i].x, true);
  }
}

// =====================

void spawnFood() {
  food.x = random(0, 8);
  food.y = random(0, 8);
}
