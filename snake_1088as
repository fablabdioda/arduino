#include <LedControl.h>

// ===== PINY =====
#define DIN_PIN 10
#define CLK_PIN 14
#define CS_PIN  16

#define BTN_LEFT  2
#define BTN_RIGHT 3
#define BUZZER    9

#define MAX_LENGTH 64

// ===== LED Matrix =====
LedControl lc = LedControl(DIN_PIN, CLK_PIN, CS_PIN, 1);

// ===== Kierunki =====
enum Direction { UP, RIGHT, DOWN, LEFT };
Direction dir = RIGHT;

// ===== Struktury =====
struct Point {
  int x;
  int y;
};

// ===== Snake =====
Point snake[MAX_LENGTH];
int snakeLength = 3;

// ===== Jabłko =====
Point food;

// ===== Zmienne gry =====
unsigned long lastMove = 0;
int gameSpeed = 300;

// ===== Setup =====
void setup() {
  pinMode(BTN_LEFT, INPUT_PULLUP);
  pinMode(BTN_RIGHT, INPUT_PULLUP);
  pinMode(BUZZER, OUTPUT);

  lc.shutdown(0, false);
  lc.setIntensity(0, 8);
  lc.clearDisplay(0);

  snake[0] = {3, 4};
  snake[1] = {2, 4};
  snake[2] = {1, 4};

  randomSeed(analogRead(A0));
  spawnFood();
}

// ===== Loop =====
void loop() {
  handleButtons();

  if (millis() - lastMove > gameSpeed) {
    lastMove = millis();
    moveSnake();
    draw();
  }
}

// =====================

void handleButtons() {
  static unsigned long lastPress = 0;
  const int debounceTime = 200; // ms

  if (!digitalRead(BTN_LEFT) && millis() - lastPress > debounceTime) {
    dir = (Direction)((dir + 3) % 4);
    lastPress = millis();
  }

  if (!digitalRead(BTN_RIGHT) && millis() - lastPress > debounceTime) {
    dir = (Direction)((dir + 1) % 4);
    lastPress = millis();
  }
}

// =====================

void moveSnake() {
  // przesuwanie ciała
  for (int i = snakeLength - 1; i > 0; i--) {
    snake[i] = snake[i - 1];
  }

  // ruch głowy
  if (dir == UP)    snake[0].y--;
  if (dir == DOWN)  snake[0].y++;
  if (dir == LEFT)  snake[0].x--;
  if (dir == RIGHT) snake[0].x++;

  // zawijanie
  snake[0].x = (snake[0].x + 8) % 8;
  snake[0].y = (snake[0].y + 8) % 8;

  // zjedzenie jabłka
  if (snake[0].x == food.x && snake[0].y == food.y) {
    if (snakeLength < MAX_LENGTH) snakeLength++;

    beep(BUZZER, 2000, 80);  // beep przy jedzeniu
    spawnFood();

    if (gameSpeed > 120) gameSpeed -= 10;
  }

  // kolizja z ciałem
  if (checkCollision()) {
    resetGame();
  }
}

// =====================

void draw() {
  lc.clearDisplay(0);

  // jabłko
  lc.setLed(0, food.y, food.x, true);

  // snake
  for (int i = 0; i < snakeLength; i++) {
    lc.setLed(0, snake[i].y, snake[i].x, true);
  }
}

// =====================

void spawnFood() {
  // losowanie jabłka
  bool onSnake;
  do {
    onSnake = false;
    food.x = random(0, 8);
    food.y = random(0, 8);

    for (int i = 0; i < snakeLength; i++) {
      if (snake[i].x == food.x && snake[i].y == food.y) {
        onSnake = true;
        break;
      }
    }
  } while (onSnake);
}

// =====================

bool checkCollision() {
  for (int i = 1; i < snakeLength; i++) {
    if (snake[0].x == snake[i].x && snake[0].y == snake[i].y) {
      return true;
    }
  }
  return false;
}

// =====================

void resetGame() {
  // beep przy śmierci
  beep(BUZZER, 400, 300);
  delay(200);
  beep(BUZZER, 200, 400);

  // reset parametrów
  snakeLength = 3;
  dir = RIGHT;
  gameSpeed = 300;

  snake[0] = {3, 4};
  snake[1] = {2, 4};
  snake[2] = {1, 4};

  spawnFood();
}

// =====================

void beep(int pin, int frequency, int duration) {
  tone(pin, frequency);
  delay(duration);
  noTone(pin);
}
