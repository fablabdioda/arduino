#include <LedControl.h>

// ===== PINY =====
#define DIN_PIN 10
#define CLK_PIN 14
#define CS_PIN  16

#define JOY_X A0
#define JOY_Y A1

#define BUZZER 9

#define MAX_LENGTH 64

// ===== LED Matrix =====
LedControl lc = LedControl(DIN_PIN, CLK_PIN, CS_PIN, 1);

// ===== Kierunki =====
enum Direction { UP, RIGHT, DOWN, LEFT };
Direction dir = RIGHT;

// ===== Struktury =====
struct Point {
  int x;
  int y;
};

// ===== Snake =====
Point snake[MAX_LENGTH];
int snakeLength = 3;

// ===== Jabłko =====
Point food;

// ===== Zmienne gry =====
unsigned long lastMove = 0;
int gameSpeed = 300;

// ===== Apple blink =====
bool appleVisible = true;
unsigned long lastBlink = 0;
const int blinkInterval = 40; // fast blink (ms)

// =====================
// SUPER MARIO MUSIC
// =====================

#define NOTE_C4  262
#define NOTE_D4  294
#define NOTE_E4  330
#define NOTE_F4  349
#define NOTE_G4  392
#define NOTE_A4  440
#define NOTE_B4  494

#define NOTE_C5  523
#define NOTE_D5  587
#define NOTE_E5  659
#define NOTE_F5  698
#define NOTE_G5  784
#define NOTE_A5  880

#define NOTE_AS4 466
#define REST 0

unsigned long lastNoteTime = 0;
int melodyIndex = 0;

// Mario-style melody
int melody[] = {
  NOTE_E5, NOTE_E5, REST, NOTE_E5,
  REST, NOTE_C5, NOTE_E5, REST,
  NOTE_G5, REST, REST, REST,
  NOTE_G4, REST, REST, REST,

  NOTE_C5, REST, REST, NOTE_G4,
  REST, REST, NOTE_E4, REST,
  REST, NOTE_A4, REST, NOTE_B4,
  REST, NOTE_AS4, NOTE_A4,

  NOTE_G4, NOTE_E5, NOTE_G5,
  NOTE_A5, REST, NOTE_F5, NOTE_G5,
  REST, NOTE_E5, REST, NOTE_C5,
  NOTE_D5, NOTE_B4, REST
};

int noteDurations[] = {
  150, 150, 150, 150,
  150, 150, 150, 150,
  300, 150, 150, 300,
  300, 150, 150, 300,

  225, 150, 150, 225,
  150, 150, 225, 150,
  150, 225, 150, 225,
  150, 150, 225,

  200, 200, 200,
  300, 150, 200, 200,
  150, 200, 150, 200,
  200, 300, 200
};

const int melodyLength =
  sizeof(melody) / sizeof(melody[0]);

// ===== Setup =====
void setup() {
  pinMode(BUZZER, OUTPUT);

  lc.shutdown(0, false);
  lc.setIntensity(0, 8);
  lc.clearDisplay(0);

  snake[0] = {3, 4};
  snake[1] = {2, 4};
  snake[2] = {1, 4};

  randomSeed(analogRead(A2));
  spawnFood();
}

// ===== Loop =====
void loop() {
  handleJoystick();
  playMusic();

  // apple blinking (independent)
  if (millis() - lastBlink > blinkInterval) {
    lastBlink = millis();
    appleVisible = !appleVisible;
    draw(); // redraw immediately
  }

  // snake movement
  if (millis() - lastMove > gameSpeed) {
    lastMove = millis();
    moveSnake();
    draw();
  }
}

// =====================
// JOYSTICK CONTROL
// =====================

void handleJoystick() {
  int xValue = analogRead(JOY_X);
  int yValue = analogRead(JOY_Y);

  const int deadzoneLow = 400;
  const int deadzoneHigh = 600;

  Direction newDir = dir;

  // gora / dol
  if (yValue < deadzoneLow) {
    newDir = DOWN;
  }
  else if (yValue > deadzoneHigh) {
    newDir = UP;
  }

  // lewo / prawo
  if (xValue < deadzoneLow) {
    newDir = LEFT;
  }
  else if (xValue > deadzoneHigh) {
    newDir = RIGHT;
  }

  // blokada cofania się w siebie
  if (!isOppositeDirection(newDir)) {
    dir = newDir;
  }
}

bool isOppositeDirection(Direction newDir) {
  return
    (dir == UP && newDir == DOWN) ||
    (dir == DOWN && newDir == UP) ||
    (dir == LEFT && newDir == RIGHT) ||
    (dir == RIGHT && newDir == LEFT);
}

// =====================
// MOVE SNAKE
// =====================

void moveSnake() {
  // przesuwanie ciała
  for (int i = snakeLength - 1; i > 0; i--) {
    snake[i] = snake[i - 1];
  }

  // ruch głowy
  if (dir == UP)    snake[0].y--;
  if (dir == DOWN)  snake[0].y++;
  if (dir == LEFT)  snake[0].x--;
  if (dir == RIGHT) snake[0].x++;

  // zawijanie planszy
  snake[0].x = (snake[0].x + 8) % 8;
  snake[0].y = (snake[0].y + 8) % 8;

  // zjedzenie jabłka
  if (snake[0].x == food.x && snake[0].y == food.y) {

    if (snakeLength < MAX_LENGTH) {
      snakeLength++;
    }

    // dźwięk jedzenia
    tone(BUZZER, 2000, 80);

    spawnFood();

    // przyspieszanie gry
    if (gameSpeed > 120) {
      gameSpeed -= 10;
    }
  }

  // kolizja
  if (checkCollision()) {
    resetGame();
  }
}

// =====================
// DRAW
// =====================

void draw() {
  lc.clearDisplay(0);

  // blinking apple
  if (appleVisible) {
    lc.setLed(0, food.y, food.x, true);
  }

  // snake
  for (int i = 0; i < snakeLength; i++) {
    lc.setLed(0, snake[i].y, snake[i].x, true);
  }
}


// =====================
// FOOD
// =====================

void spawnFood() {
  bool onSnake;

  do {
    onSnake = false;

    food.x = random(0, 8);
    food.y = random(0, 8);

    for (int i = 0; i < snakeLength; i++) {
      if (snake[i].x == food.x &&
          snake[i].y == food.y) {
        onSnake = true;
        break;
      }
    }

  } while (onSnake);
}

// =====================
// COLLISION
// =====================

bool checkCollision() {
  for (int i = 1; i < snakeLength; i++) {
    if (snake[0].x == snake[i].x &&
        snake[0].y == snake[i].y) {
      return true;
    }
  }
  return false;
}

// =====================
// GAME RESET
// =====================

void resetGame() {

  // śmierć melodyjka
  tone(BUZZER, 400, 300);
  delay(350);

  tone(BUZZER, 200, 400);
  delay(450);

  noTone(BUZZER);

  int score = snakeLength - 3;
  showScore(score);


  // reset
  snakeLength = 3;
  dir = RIGHT;
  gameSpeed = 300;

  snake[0] = {3, 4};
  snake[1] = {2, 4};
  snake[2] = {1, 4};

  spawnFood();
}

// =====================
// BACKGROUND MUSIC
// =====================

void playMusic() {
  if (millis() - lastNoteTime >= noteDurations[melodyIndex]) {

    lastNoteTime = millis();

    int note = melody[melodyIndex];

    if (note == REST) {
      noTone(BUZZER);
    } else {
      tone(BUZZER, note);
    }

    melodyIndex++;

    if (melodyIndex >= melodyLength) {
      melodyIndex = 0;
    }
  }
}

void showScore(int score) {

  // 5x7 digit font
  byte digits[10][5] = {
    {0x3E,0x51,0x49,0x45,0x3E}, //0
    {0x00,0x42,0x7F,0x40,0x00}, //1
    {0x62,0x51,0x49,0x49,0x46}, //2
    {0x22,0x49,0x49,0x49,0x36}, //3
    {0x18,0x14,0x12,0x7F,0x10}, //4
    {0x2F,0x49,0x49,0x49,0x31}, //5
    {0x3E,0x49,0x49,0x49,0x32}, //6
    {0x01,0x71,0x09,0x05,0x03}, //7
    {0x36,0x49,0x49,0x49,0x36}, //8
    {0x26,0x49,0x49,0x49,0x3E}  //9
  };

  String scoreText = String(score);

  // Build scrolling buffer
  const int spacing = 1;
  int totalCols = scoreText.length() * (5 + spacing);

  byte scrollBuffer[100]; // enough for large score
  int index = 0;

  // convert digits into column buffer
  for (int i = 0; i < scoreText.length(); i++) {

    int digit = scoreText[i] - '0';

    for (int col = 0; col < 5; col++) {
      scrollBuffer[index++] = digits[digit][col];
    }

    // spacing column
    scrollBuffer[index++] = 0x00;
  }

  // scroll from right to left
  for (int offset = -8; offset < totalCols; offset++) {

    lc.clearDisplay(0);

    for (int x = 0; x < 8; x++) {

      int bufferIndex = offset + x;

      if (bufferIndex >= 0 &&
          bufferIndex < totalCols) {

        byte column = scrollBuffer[bufferIndex];

        // draw column pixels
        for (int y = 0; y < 7; y++) {
          bool pixel = bitRead(column, 6 - y);
          lc.setLed(0, y, 7 - x, pixel);
        }
      }
    }

    delay(90);
  }

  delay(1000); // small pause at end
}
