// ===== USTAWIENIA PINÓW =====
const int ledPin = 5;      // dioda podłączona do pinu 5
const int buttonPin = 7;   // przycisk podłączony do pinu 7 (do GND)


// ===== ZMIENNE =====
unsigned long startTime;       // moment zapalenia LED
unsigned long waitUntil;       // moment, kiedy LED ma się zapalić
bool ledOn = false;            // czy dioda aktualnie świeci?
bool gameReady = false;        // czy czekamy na reakcję gracza?


void setup() {

  pinMode(ledPin, OUTPUT);          // ustaw LED jako wyjście
  pinMode(buttonPin, INPUT_PULLUP); // włączamy wewnętrzny rezystor podciągający

  Serial.begin(9600);               // start komunikacji z komputerem

  randomSeed(analogRead(A0));       // losowość (żeby czasy nie były takie same)

  newRound();                       // start pierwszej rundy
}


void loop() {

  // ===== 1. Czekanie aż minie losowy czas =====
  if (!ledOn && millis() >= waitUntil) {
    digitalWrite(ledPin, HIGH);  // zapal diodę
    startTime = millis();        // zapisz moment zapalenia
    ledOn = true;                // zaznacz że LED świeci
    gameReady = true;            // można reagować
  }


  // ===== 2. Gracz klika przy zapalonej diodzie =====
  if (gameReady && digitalRead(buttonPin) == LOW) {

    unsigned long reaction = millis() - startTime; // oblicz czas reakcji

    digitalWrite(ledPin, LOW);   // zgaś diodę

    Serial.print("Czas reakcji: "); //=== Wynik pokazuje się w serial monitorze. Włączamy go w arduino IDE klikając ctrl+shift+M ===
    Serial.print(reaction);
    Serial.println(" ms");

    gameReady = false;  // blokujemy kolejne kliknięcie
    ledOn = false;

    delay(300);         // małe opóźnienie (debounce)

    newRound();         // od razu start nowej rundy
  }
}


// ===== FUNKCJA STARTUJĄCA NOWĄ RUNDĘ =====
void newRound() {

  digitalWrite(ledPin, LOW);     // upewnij się że LED jest zgaszona

  // ustaw losowy czas 2–5 sekund w przyszłości
  waitUntil = millis() + random(2000, 5000);

  ledOn = false;
  gameReady = false;

  Serial.println("Nowa runda...");
}
