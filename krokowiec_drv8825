const int stepPin = 8;
const int dirPin  = 9;
const int potPin  = A7;
const int btnPin  = 7;

bool lastBtnState = HIGH;

void setup() {
  pinMode(stepPin, OUTPUT);
  pinMode(dirPin, OUTPUT);
  pinMode(btnPin, INPUT_PULLUP);

  digitalWrite(dirPin, HIGH);   // forward direction
}

void doStep(int stepDelay) {
  digitalWrite(stepPin, HIGH);
  delayMicroseconds(stepDelay);
  digitalWrite(stepPin, LOW);
  delayMicroseconds(stepDelay);
}

void loop() {
  int potValue = analogRead(potPin);

  // ---- STOP zone ----
  if (potValue > 20) {  // pot NOT at zero
    int stepDelay = map(potValue, 20, 1023, 3000, 200);
    doStep(stepDelay);
  }
  // else: pot near 0 → NO stepping → motor stopped

  // ---- Single-step button (always works) ----
  bool btnState = digitalRead(btnPin);

  if (lastBtnState == HIGH && btnState == LOW) {
    doStep(800);   // one clean step forward
  }

  lastBtnState = btnState;
}
